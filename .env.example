# ---------------------------------------------------------------------------
# Facebook Lead Finder — environment variables
#
# Copy to `.env` and fill in. `.env` is gitignored.
#
# Two naming conventions are in play, and both are needed:
#   VITE_*  is inlined into the browser bundle at build time (public values only)
#   bare    is read from process.env during SSR / inside the Cloudflare Worker
#
# Anything genuinely secret must NOT have a VITE_ prefix and must NOT be
# committed. In deployed environments secrets are Worker secrets, set with:
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY --name facebookleadfinder-staging
# ---------------------------------------------------------------------------

# --- Supabase (public) -----------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# --- Supabase (SECRET — Worker secret in deployed environments) ------------
# Bypasses Row Level Security. Only the scheduled jobs:sweep task (see
# tasks/jobs/sweep.ts) uses it — it runs with no user session, so it can't use
# the normal per-request auth middleware. The in-app "Load demo data" button
# (Phase 7) does not need this: it runs as the signed-in user, under RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Search providers ------------------------------------------------------
# Which provider a new account defaults to. `mock` needs no credentials and
# exercises the entire workflow with seeded demo data.
#   mock | google_places
SEARCH_PROVIDER=mock

# Google Places API (New) v1. Requires a Google Cloud project with the
# "Places API (New)" enabled and billing turned on. SECRET — Worker secret.
GOOGLE_PLACES_API_KEY=

# --- Not implemented -------------------------------------------------------
# These providers exist as documented stubs behind the SearchProvider
# interface. Setting a key here does nothing until an adapter is written.
# Note: Microsoft retired the Bing Web Search API in August 2025.
BING_SEARCH_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=
